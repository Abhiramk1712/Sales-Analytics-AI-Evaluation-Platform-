{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/money_path_gate.py\"",
            "timeout": 15,
            "statusMessage": "Checking money-path approach\u2026"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_claude_md.py\" --quiet --skip-slow 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Checking CLAUDE.md for drift\u2026"
          }
        ]
      }
    ]
  }
}
