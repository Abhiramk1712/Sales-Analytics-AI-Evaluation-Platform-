  "required_tables": [
    "teams",
    "users",
    "accounts",
    "opportunities",
    "revenue"
  ],
  "optional_tables": [
    "activities",
    "quotas"
  ],
  "metadata": {
    "schema_type": "sales_analytics",
    "min_tables": 5,
    "max_tables": 22,
    "supported_domains": [
      "organization",
      "accounts",
      "opportunities",
      "revenue",
      "quotas",
      "activities",
      "compensation",
      "territory",
      "brands",
      "finance"
    ]
  },
  "validation_rules": {
    "opportunities": [
      "stage IN ('Prospecting', 'Qualification', 'Proposal', 'Negotiation', 'Closed Won', 'Closed Lost')",
      "amount > 0",
      "close_date >= created_date"
    ],
    "revenue": [
      "amount >= 0"
    ],
    "quotas": [
      "amount > 0"
    ]
  }
}
