    "activities_user_fk": {
      "relationship_id": "activities_user_fk",
      "relationship_type": "direct_fk",
      "description": "Activities performed by users",
      "direct_fk": {
        "local_table": "activities",
        "local_column": "user_id",
        "remote_table": "users",
        "remote_column": "id",
        "nullable": false,
